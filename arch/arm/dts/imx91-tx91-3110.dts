/dts-v1/;

#include "imx91-karo.dtsi"

/ {
	model = "Ka-Ro electronics GmbH TX91-3110 (NXP i.MX91) module";
	compatible = "karo,tx91-3110", "fsl,imx91";

	aliases {
		mmc1 = &usdhc2;
		i2c0 = &lpi2c1; /* PMIC */
		i2c1 = &lpi2c3;
		i2c2 = &lpi2c6;
		i2c3 = &lpi2c7;
		i2c4 = &lpi2c8;
		i2c5 = &lpi2c5;
		i2c6 = &lpi2c4;
		i2c7 = &lpi2c2;
		serial0 = &lpuart1;
		serial1 = &lpuart4;
		serial2 = &lpuart5;
		serial3 = &lpuart2;
		serial4 = &lpuart6;
		serial5 = &lpuart7;
		serial6 = &lpuart8;
		serial7 = &lpuart3;
	};
};

&eqos {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_eqos_rmii &pinctrl_ethphy0_rst>;
	assigned-clock-rates = <0 50000000>;
	phy-mode = "rmii";
	phy-handle = <&ethphy0>;
	phy-supply = <&reg_vdd_3v3>;
	phy-reset-gpios = <&gpio4 13 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <25000>; /* µs */
	phy-reset-post-delay = <10>; /* µs */
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <2500000>;

		ethphy0: ethernet-phy@0 {
			reg = <0>;
			smsc,disable-energy-detect;
		};
	};
};

&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec_rgmii>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;
	phy-supply = <&reg_vdd_3v3>;
	phy-reset-gpios = <&gpio4 13 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <10>; /* ms */
	phy-reset-post-delay = <1>; /* ms */

	mdio {
		ethphy1: ethernet-phy@3 {
			reg = <3>;
		};
	};
};

&lpi2c3 {
	clock-frequency = <400000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3_gpio>;
	scl-gpios = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	status = "okay";
};

&lpspi3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi3 &pinctrl_lpspi3_cs>;
	spi-max-frequency = <25000000>;
};

&lpuart1 { /* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart1 &pinctrl_lpuart1_rtscts>;
	uart-has-rtscts;
	status = "okay";
};

&lpuart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart2>;
};

&lpuart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart3 &pinctrl_lpuart3_rtscts>;
	uart-has-rtscts;
};

&lpuart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart4 &pinctrl_lpuart4_rtscts>;
	uart-has-rtscts;
	status = "okay";
};

&lpuart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart5 &pinctrl_lpuart5_rtscts>;
	uart-has-rtscts;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	vmmc-supply = <&reg_vdd_3v3>;
	vqmmc-supply = <&reg_vdd_3v3>;
	bus-width = <4>;
	no-1-8-v;
	no-sdio;
	no-mmc;
	status = "okay";
};

&iomuxc {
	pinctrl-names = "default";
	status = "okay";

	pinctrl_eqos_rmii: eqos-rmiigrp {
		fsl,pins = <
			MX91_PAD_ENET1_MDC__ENET_QOS_MDC		0x57e
			MX91_PAD_ENET1_MDIO__ENET_QOS_MDIO		0x17e
			MX91_PAD_ENET1_TD0__ENET_QOS_RGMII_TD0		0x57e
			MX91_PAD_ENET1_TD1__ENET_QOS_RGMII_TD1		0x57e
			MX91_PAD_ENET1_TX_CTL__ENET_QOS_RGMII_TX_CTL	0x57e
			MX91_PAD_ENET1_TD2__ENET_QOS_CLOCK_GENERATE_CLK	0x4000017e
			/* SMSC LAN8710 Strap pins */
			MX91_PAD_ENET1_RD0__ENET_QOS_RGMII_RD0		0x37e /* MODE0 */
			MX91_PAD_ENET1_RD1__ENET_QOS_RGMII_RD1		0x37e /* MODE1 */
			MX91_PAD_ENET1_RX_CTL__ENET_QOS_RGMII_RX_CTL	0x37e /* MODE2 (ext. Pullup) */
			MX91_PAD_ENET1_RXC__ENET_QOS_RX_ER		0x57e /* PHYAD0 */
		>;
	};

	pinctrl_ethphy0_rst: ethphy0-rstgrp {
		fsl,pins = <
			MX91_PAD_ENET1_RD3__GPIO4_IO13			0x17e
		>;
	};

	pinctrl_fec_rgmii: fec-rgmiigrp {
		fsl,pins = <
			MX91_PAD_ENET2_MDC__ENET2_MDC			0x57e
			MX91_PAD_ENET2_MDIO__ENET2_MDIO			0x17e
			MX91_PAD_ENET2_TD0__ENET2_RGMII_TD0		0x57e
			MX91_PAD_ENET2_TD1__ENET2_RGMII_TD1		0x57e
			MX91_PAD_ENET2_TD2__ENET2_RGMII_TD2		0x57e
			MX91_PAD_ENET2_TD3__ENET2_RGMII_TD3		0x57e
			MX91_PAD_ENET2_TXC__ENET2_RGMII_TXC		0x5fe
			MX91_PAD_ENET2_RD0__ENET2_RGMII_RD0		0x37e
			MX91_PAD_ENET2_RD2__ENET2_RGMII_RD2		0x37e
			MX91_PAD_ENET2_RD3__ENET2_RGMII_RD3		0x37e
			/* KSZ9031 Strap pins 0x5..: HIGH 0x3..: LOW */
			MX91_PAD_ENET2_RXC__ENET2_RGMII_RXC		0x3fe /* PHYAD2 */
			MX91_PAD_ENET2_TX_CTL__ENET2_RGMII_TX_CTL	0x37e /* MODE0 */
			MX91_PAD_ENET2_RD1__ENET2_RGMII_RD1		0x37e /* MODE1 */
			MX91_PAD_ENET2_TD3__ENET2_RGMII_TD3		0x37e /* MODE2 */
			MX91_PAD_ENET2_TD2__ENET2_RGMII_TD2		0x37e /* MODE3 */
			MX91_PAD_ENET2_RX_CTL__ENET2_RGMII_RX_CTL	0x57e /* CLK125_EN */
		>;
	};

	pinctrl_lcdif: lcdifgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO00__MEDIAMIX_DISP_CLK		0x31e
			MX91_PAD_GPIO_IO01__MEDIAMIX_DISP_DE		0x31e
			MX91_PAD_GPIO_IO02__MEDIAMIX_DISP_VSYNC		0x31e
			MX91_PAD_GPIO_IO03__MEDIAMIX_DISP_HSYNC		0x31e
			MX91_PAD_GPIO_IO04__MEDIAMIX_DISP_DATA0		0x31e
			MX91_PAD_GPIO_IO05__MEDIAMIX_DISP_DATA1		0x31e
			MX91_PAD_GPIO_IO06__MEDIAMIX_DISP_DATA2		0x31e
			MX91_PAD_GPIO_IO07__MEDIAMIX_DISP_DATA3		0x31e
			MX91_PAD_GPIO_IO08__MEDIAMIX_DISP_DATA4		0x31e
			MX91_PAD_GPIO_IO09__MEDIAMIX_DISP_DATA5		0x31e
			MX91_PAD_GPIO_IO10__MEDIAMIX_DISP_DATA6		0x31e
			MX91_PAD_GPIO_IO11__MEDIAMIX_DISP_DATA7		0x31e
			MX91_PAD_GPIO_IO12__MEDIAMIX_DISP_DATA8		0x31e
			MX91_PAD_GPIO_IO13__MEDIAMIX_DISP_DATA9		0x31e
			MX91_PAD_GPIO_IO14__MEDIAMIX_DISP_DATA10	0x31e
			MX91_PAD_GPIO_IO15__MEDIAMIX_DISP_DATA11	0x31e
			MX91_PAD_GPIO_IO16__MEDIAMIX_DISP_DATA12	0x31e
			MX91_PAD_GPIO_IO17__MEDIAMIX_DISP_DATA13	0x31e
			MX91_PAD_GPIO_IO18__MEDIAMIX_DISP_DATA14	0x31e
			MX91_PAD_GPIO_IO19__MEDIAMIX_DISP_DATA15	0x31e
			MX91_PAD_GPIO_IO20__MEDIAMIX_DISP_DATA16	0x31e
			MX91_PAD_GPIO_IO21__MEDIAMIX_DISP_DATA17	0x31e
			MX91_PAD_GPIO_IO22__MEDIAMIX_DISP_DATA18	0x31e
			MX91_PAD_GPIO_IO23__MEDIAMIX_DISP_DATA19	0x31e
			MX91_PAD_GPIO_IO24__MEDIAMIX_DISP_DATA20	0x31e
			MX91_PAD_GPIO_IO25__MEDIAMIX_DISP_DATA21	0x31e
			MX91_PAD_GPIO_IO26__MEDIAMIX_DISP_DATA22	0x31e
			MX91_PAD_GPIO_IO27__MEDIAMIX_DISP_DATA23	0x31e
		>;
	};

	pinctrl_flexcan2: flexcan2grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO25__CAN2_TX			0x39e
			MX91_PAD_GPIO_IO27__CAN2_RX			0x39e
		>;
	};

	pinctrl_lpi2c3: lpi2c3grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO29__LPI2C3_SCL			0x40001b1e
			MX91_PAD_GPIO_IO28__LPI2C3_SDA			0x40001b1e
		>;
	};

	pinctrl_lpi2c3_gpio: lpi2c3-gpiogrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO29__GPIO2_IO29			0x40001b1e
			MX91_PAD_GPIO_IO28__GPIO2_IO28			0x40001b1e
		>;
	};

	pinctrl_lpspi3: lpspi3-grp {
		fsl,pins = <
			MX91_PAD_SAI1_TXC__LPSPI1_SIN			0x31e
			MX91_PAD_SAI1_RXD0__LPSPI1_SOUT			0x11e
			MX91_PAD_SAI1_TXD0__LPSPI1_SCK			0x11e
		>;
	};

	pinctrl_lpspi3_cs: lpspi3-csgrp {
		fsl,pins = <
			MX91_PAD_SAI1_TXFS__GPIO1_IO11			0x31e
		>;
	};

	pinctrl_pmic: pmicgrp {
		fsl,pins = <
			MX91_PAD_WDOG_ANY__GPIO1_IO15			0x31e
		>;
	};

	pinctrl_lpuart4_rtscts: uart4-rtsctsgrp {
		fsl,pins = <
			MX91_PAD_ENET2_RD2__LPUART4_CTS_B		0x31e
			MX91_PAD_ENET2_TD1__LPUART4_RTS_B		0x31e
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX91_PAD_SD2_CLK__USDHC2_CLK			0x7fe
			MX91_PAD_SD2_CMD__USDHC2_CMD			0x3fe
			MX91_PAD_SD2_DATA0__USDHC2_DATA0		0x3fe
			MX91_PAD_SD2_DATA1__USDHC2_DATA1		0x3fe
			MX91_PAD_SD2_DATA2__USDHC2_DATA2		0x3fe
			MX91_PAD_SD2_DATA3__USDHC2_DATA3		0x3fe
		>;
	};

	pinctrl_usdhc2_cd: usdhc2-cdgrp {
		fsl,pins = <
			MX91_PAD_SD2_CD_B__GPIO3_IO0			0x31e
		>;
	};
};
