/ {
	aliases {
		/* Keep the PMIC bus at i2c0, like the legacy. */
		i2c0 = &i2c_pmic;
		serial0 = &uart1;
		usb0 = &usbotg1;
	};

	chosen {
		stdout-path = &uart1;
	};

	i2c_pmic: i2c-gpio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2c_pmic>;
		sda-gpios = <&gpio5 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio5 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		status = "okay";

		pmic: pmic@33 {
			compatible = "ricoh,rn5t567";
			reg = <0x33>;
		};
	};

	reg_fec_pwr: regulator-fec-pwr {
		compatible = "regulator-fixed";
		regulator-name = "fec_pwr";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_fec_pwr>;
		gpio = <&gpio5 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_usbh1_vbus: regulator-usbh1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usbh1_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usbh1_vbus &pinctrl_usbh1_oc>;
		gpio = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_usbotg1_vbus: regulator-usbotg1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usbotg1_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usb_otg1>;
		gpio = <&gpio1 26 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec1
		     &pinctrl_fec_reset
		     &pinctrl_fec_int>;
	phy-mode = "rmii";
	phy-handle = <&ethphy0>;
	phy-supply = <&reg_fec_pwr>;
	phy-reset-gpios = <&gpio5 6 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <1>;
	phy-reset-post-delay = <22>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&usbotg1 {
	/* USBOTG_ID not connected, K700-098B sheet 01 */
	dr_mode = "peripheral";
	vbus-supply = <&reg_usbotg1_vbus>;
	status = "okay";
};

&usbotg2 {
	dr_mode = "host";
	vbus-supply = <&reg_usbh1_vbus>;
	status = "okay";
};

&iomuxc {
	/* drive strengths from baf66ec0074 (EMC) */
	pinctrl_fec1: fec1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO07__ENET1_MDC		0x00010
			MX6UL_PAD_GPIO1_IO06__ENET1_MDIO	0x0b010
			MX6UL_PAD_ENET1_TX_CLK__ENET1_REF_CLK1	0x40000018 /* SION loops the clock back */
			MX6UL_PAD_ENET1_RX_ER__ENET1_RX_ER	0x000d1 /* PHYAD0 strap: no pull */
			MX6UL_PAD_ENET1_RX_EN__ENET1_RX_EN	0x0b0d1
			MX6UL_PAD_ENET1_RX_DATA0__ENET1_RDATA00	0x0b0d1
			MX6UL_PAD_ENET1_RX_DATA1__ENET1_RDATA01	0x0b0d1
			MX6UL_PAD_ENET1_TX_EN__ENET1_TX_EN	0x0b0d1
			MX6UL_PAD_ENET1_TX_DATA0__ENET1_TDATA00	0x0b0d1
			MX6UL_PAD_ENET1_TX_DATA1__ENET1_TDATA01	0x0b0d1
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX	0x0b0b0
			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX	0x0b0b0
		>;
	};

	pinctrl_usb_otg1: usbotg1grp {
		fsl,pins = <
			MX6UL_PAD_UART3_CTS_B__GPIO1_IO26	0x100b0 /* MB7 R8 pulls down */
			MX6UL_PAD_UART3_RTS_B__GPIO1_IO27	0x07000
		>;
	};

	/* OC lines muxed only; usb_oc_config() disables detection unconditionally. */
	pinctrl_usbh1_oc: usbh1ocgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO03__GPIO1_IO03	0x17059
		>;
	};

	pinctrl_usbh1_vbus: usbh1vbusgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO02__GPIO1_IO02	0x000b0 /* MB7 R7 pulls down */
		>;
	};
};
