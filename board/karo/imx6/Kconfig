if TARGET_KARO_IMX6

config SYS_BOARD
	default "imx6"

config SYS_CONFIG_NAME
	default "imx6-karo"

config SYS_VENDOR
	default "karo"

config KARO_IMX6
	bool
	select CI_UDC_DISABLE_STREAMING if CI_UDC
	select DM
	select DM_ETH
	select DM_MMC
	imply BOARD_LATE_INIT
	imply DM_I2C_GPIO
	imply DM_PMIC
	imply FEC_MXC
	imply MXC_OCOTP
	imply OF_LIBFDT_OVERLAY
	imply OF_BOARD_SETUP
	imply PMIC_RN5T567

config KARO_IMX6_NAND
	bool
	imply CMD_MTDPARTS
	imply DM_MTD
	imply FDT_FIXUP_PARTITIONS
	imply MTD
	imply MTD_RAW_NAND
	imply NAND_MXS
	imply NAND_MXS_DT
	imply SYS_NAND_ONFI_DETECTION
	imply SYS_NAND_USE_FLASH_BBT

config KARO_IMX6_EMMC
	bool

choice
	prompt "Ka-Ro i.MX6 module variant"

config KARO_TXUL_8013
	bool "Ka-Ro TXUL-8013 module (i.MX6ULL, 512M DDR3L, 4G eMMC)"
	depends on MX6ULL
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TXUL_5011
	bool "Ka-Ro TXUL-5011 module (i.MX6UL, 256M DDR3, 4G eMMC)"
	depends on MX6UL
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TXUL_5010
	bool "Ka-Ro TXUL-5010 module (i.MX6UL, 256M DDR3, 128M NAND)"
	depends on MX6UL
	select KARO_IMX6
	select KARO_IMX6_NAND

config KARO_TX6S_8034
	bool "Ka-Ro TX6S-8034 module (i.MX6S, 256M DDR3, 128M NAND)"
	depends on MX6S
	select KARO_IMX6
	select KARO_IMX6_NAND

config KARO_TX6S_8134
	bool "Ka-Ro TX6S-8134 module (i.MX6S, 256M DDR3, 128M NAND, LVDS)"
	depends on MX6S
	select KARO_IMX6
	select KARO_IMX6_NAND

config KARO_TX6S_8035
	bool "Ka-Ro TX6S-8035 module (i.MX6S, 512M DDR3, 4G eMMC)"
	depends on MX6S
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TX6S_8135
	bool "Ka-Ro TX6S-8135 module (i.MX6S, 512M DDR3, 4G eMMC, LVDS)"
	depends on MX6S
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TX6U_8030
	bool "Ka-Ro TX6U-8030 module (i.MX6DL, 1G DDR3, 128M SLC NAND)"
	depends on MX6DL
	select KARO_IMX6
	select KARO_IMX6_NAND

config KARO_TX6U_8130
	bool "Ka-Ro TX6U-8130 module (i.MX6DL, 1G DDR3, 128M SLC NAND, LVDS)"
	depends on MX6DL
	select KARO_IMX6
	select KARO_IMX6_NAND

config KARO_TX6U_8033
	bool "Ka-Ro TX6U-8033 module (i.MX6DL, 1G DDR3, 4G eMMC)"
	depends on MX6DL
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TX6U_8133
	bool "Ka-Ro TX6U-8133 module (i.MX6DL, 1G DDR3, 4G eMMC, LVDS)"
	depends on MX6DL
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TX6Q_1030
	bool "Ka-Ro TX6Q-1030 module (i.MX6Q, 1G DDR3, 128M SLC NAND)"
	depends on MX6Q
	select KARO_IMX6
	select KARO_IMX6_NAND

config KARO_TX6Q_1130
	bool "Ka-Ro TX6Q-1130 module (i.MX6Q, 1G DDR3, 128M SLC NAND, LVDS)"
	depends on MX6Q
	select KARO_IMX6
	select KARO_IMX6_NAND

config KARO_TX6Q_1036
	bool "Ka-Ro TX6Q-1036 module (i.MX6Q, 1G DDR3, 8G eMMC)"
	depends on MX6Q
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TX6Q_8037
	bool "Ka-Ro TX6Q-8037 module (i.MX6QP, 2G DDR3, 4G eMMC)"
	depends on MX6Q
	select KARO_IMX6
	select KARO_IMX6_EMMC

config KARO_TX6Q_8137
	bool "Ka-Ro TX6Q-8137 module (i.MX6QP, 2G DDR3, 4G eMMC, LVDS)"
	depends on MX6Q
	select KARO_IMX6
	select KARO_IMX6_EMMC

endchoice

config IMX_CONFIG
	default "board/karo/imx6/imximage-mx6ul.cfg" if MX6UL || MX6ULL
	default "board/karo/imx6/imximage-mx6qdl.cfg"

# i.MX6 RM Table 8-25: eMMC IVT at 1 KiB, SDP and NAND at 0
config KARO_IMX6_FLASH_PAD
	int
	default 1024 if KARO_IMX6_EMMC && !KARO_UBOOT_MFG
	default 0

endif
