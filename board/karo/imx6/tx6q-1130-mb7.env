# default environment for TX6Q-1130 on MB7 baseboard
append_bootargs=quiet
autoload=no
baseboard=mb7
boot_mode=nand
bootargs_nfs=run default_bootargs; setenv bootargs ${bootargs} root=/dev/nfs nfsroot=${nfs_server}:${nfsroot},nolock,v3 ip=dhcp ${append_bootargs} ${dyndbg}
bootargs_ubifs=run default_bootargs; setenv bootargs ${bootargs} ubi.mtd=rootfs root=ubi0:rootfs rootfstype=ubifs ${append_bootargs} ${dyndbg}
bootcmd=run bootcmd_${boot_mode} bootm_cmd
bootcmd_nand=run loadkernel bootargs_ubifs
bootcmd_nfs=run loadkernel bootargs_nfs
bootm_cmd=bootm ${loadaddr} - ${fdt_addr}
console=ttymxc0,115200 earlycon=ec_imx6q,0x02020000,115200
cpu_clk=792
default_bootargs=setenv bootargs console=${console} panic=-1 ro
dyndbg=dyndbg=\\"-p\\"
fdt_addr=13000000
fdt_file=imx6q-tx6q-1130.dtb
linux_image=uImage
loadaddr=12000000
loadfdt=ubi part rootfs; ubifsmount ubi0:boot; ubifsload ${fdt_addr} ${fdt_file}
loadkernel=ubi part rootfs; ubifsmount ubi0:boot; ubifsload ${loadaddr} ${linux_image}
mtdids=nand0=gpmi-nand
mtdparts=mtdparts=gpmi-nand:4m(nandboot),384k@0x400000(env),126080k@0x460000(rootfs),512k@0x7f80000(bbt)ro
otg_mode=peripheral
splashimage=10400000
splashpos=m,m
