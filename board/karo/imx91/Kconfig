if TARGET_KARO_IMX91

config SYS_BOARD
	default "imx91"

config SYS_VENDOR
	default "karo"

config SYS_CONFIG_NAME
	default "tx91"

config KARO_IMX91
	bool
	select BINMAN
	select IMX9_LPDDR4X
	imply BOARD_LATE_INIT
	imply CHECK_REL_DYN
	imply DM_ETH
	imply DM_PMIC
	imply FEC_MXC
	imply IMX9_LPDDR4X
	imply MII
	imply MXC_UART
	imply PHYLIB
	imply POWER
	imply SPL_DM_PMIC
	imply SPL_DM_PMIC_PCA9450
	imply SPL_POWER
	imply SPL_SERIAL

choice
	prompt "Ka-Ro IMX91 module variant"
	default KARO_QS91_3110

config KARO_QS91_3110
	bool "Ka-Ro QS91-3110 module"
	select KARO_IMX91

config KARO_TX91_3110
	bool "Ka-Ro TX91-3110 module"
	select KARO_IMX91

endchoice

endif
